  exportContactsCSVs("ALL");
}

/**
 * ==========================================
 * CORE EXPORT ENGINE
 * ==========================================
 */
function prepareBroadcastData(batchSize = CONFIG.DEFAULT_BATCH_SIZE, targetCategory = "ALL") {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheetsToProcess = targetCategory === "ALL" ? Object.keys(CATEGORY_PREFIXES) : [targetCategory];

  sheetsToProcess.forEach(sheetName => {
    const sheet = ss.getSheetByName(sheetName);
    if (!sheet) return;

    const lastRow = sheet.getLastRow();
    sheet.getRange(1, 4, 1, 3).setValues([["Group Name", "Formatted Number", "Status"]]).setFontWeight("bold");
    if (lastRow < 2) return;

    const data = sheet.getRange(2, 1, lastRow - 1, 6).getValues();
    const prefix = CATEGORY_PREFIXES[sheetName] || "GEN";

    const updatedData = data.map((row, index) => {
      let custName = row[0] ? String(row[0]).trim() : "Customer";
      let rawPhone = row[2];
      let currentStatus = row[5] || ""; 

      let groupNum = Math.floor(index / batchSize) + 1;
      let broadcastName = `${prefix} G${groupNum} ${custName}`;
      let formattedPhone = cleanPhoneNumber(rawPhone);

      return [broadcastName, formattedPhone, currentStatus];
    });

    sheet.getRange(2, 4, updatedData.length, 3).setValues(updatedData);
    sheet.autoResizeColumns(4, 3);
  });
}

function exportContactsCSVs(targetCategory = "ALL") {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  let csvStandard = {}; 
  let csvGoogleContacts = {}; 
  let sheetsToUpdate = []; 
  let exportStats = {}; 

  let sheetsToProcess = targetCategory === "ALL" ? Object.keys(CATEGORY_PREFIXES) : [targetCategory];

  sheetsToProcess.forEach(sheetName => {
    const sheet = ss.getSheetByName(sheetName);
    if (!sheet) return;

    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return;

    const dataRange = sheet.getRange(2, 4, lastRow - 1, 3);
    const data = dataRange.getValues();
    
    let hasUpdates = false;
    let sheetExportCount = 0; 

    data.forEach((row, index) => {
      let broadcastName = row[0];
      let phoneNum = String(row[1]);
      let status = row[2];

      if (broadcastName && phoneNum && status !== "Exported") {
        let filePrefix = broadcastName.split(" ").slice(0, 2).join("_"); 

        if (!csvStandard[filePrefix]) {
          csvStandard[filePrefix] = ["Name,Phone"];
          csvGoogleContacts[filePrefix] = ["Name,Phone 1 - Value"]; 
        }

        // Standard CSV Format
        csvStandard[filePrefix].push(`"${broadcastName}","${phoneNum}"`);

        // Google Contacts CSV Format (+ Country Code)
        let gcPhone = phoneNum.startsWith("+") ? phoneNum : "+" + phoneNum;
        csvGoogleContacts[filePrefix].push(`"${broadcastName}","${gcPhone}"`);
        
        data[index][2] = "Exported";
        hasUpdates = true;
        sheetExportCount++;
      }
    });

    if (hasUpdates) {
      sheetsToUpdate.push({ range: dataRange, values: data });
      exportStats[sheetName] = sheetExportCount; 
    }
  });

  let filesCreated = 0;
  Object.keys(csvStandard).forEach(fileName => {
    let csvStringStd = csvStandard[fileName].join("\n");
    DriveApp.createFile(`STD_${fileName}_Contacts.csv`, csvStringStd, MimeType.CSV);
    
    let csvStringGC = csvGoogleContacts[fileName].join("\n");
    DriveApp.createFile(`GC_${fileName}_Contacts.csv`, csvStringGC, MimeType.CSV);
    
    filesCreated += 2; 
  });

  sheetsToUpdate.forEach(update => update.range.setValues(update.values));

  // Handle Logging
  let totalExported = 0;
  let logRows = [];
  let timestamp = new Date(); 
  
  Object.keys(exportStats).forEach(sheetName => {
    let count = exportStats[sheetName];
    totalExported += count;
    let formattedTime = Utilities.formatDate(timestamp, ss.getSpreadsheetTimeZone(), "dd/MM/yyyy HH:mm:ss");
    logRows.push([formattedTime, sheetName, count]);
  });

  if (logRows.length > 0) {
    let logSheet = ss.getSheetByName(CONFIG.EXPORT_LOG_SHEET_NAME) || ss.insertSheet(CONFIG.EXPORT_LOG_SHEET_NAME, 0);
    if (logSheet.getLastRow() === 0) {
      logSheet.appendRow(["Date & Time", "Category", "Export Count"]);
      logSheet.getRange("A1:C1").setFontWeight("bold").setBackground("#f3f3f3");
    }
    logSheet.getRange(logSheet.getLastRow() + 1, 1, logRows.length, 3).setValues(logRows);
    logSheet.autoResizeColumns(1, 3);
  }

  const ui = SpreadsheetApp.getUi();
  if (filesCreated > 0) {
    ui.alert(`✅ Success! Created ${filesCreated} files total.\n\nTotal Contacts Exported: ${totalExported}\n\nCheck Google Drive for the CSV files.`);
  } else {
    ui.alert(`ℹ️ No new contacts to export for the selected category. Everyone is already marked as 'Exported'.`);
  }
}

/**
 * HELPER: Cleans phone numbers
 */
function cleanPhoneNumber(rawPhone) {
  if (!rawPhone) return "";
  let digits = String(rawPhone).replace(/\D/g, "");
  
  // Cut down platform-masked numbers (e.g., e-commerce virtual numbers)
  if (digits.length > 12) digits = digits.substring(0, 10);
  
  let cc = CONFIG.COUNTRY_CODE;
  let len = digits.length;
  let baseLength = 10; // Standard base phone number length without country code

  // Formatting logic to ensure the country code is prefixed properly
  if (len === baseLength) return cc + digits; 
  if (len === baseLength + 1 && digits.startsWith("0")) return cc + digits.substring(1); 
  if (digits.startsWith(cc)) return digits; 
  
  return digits; 
}
