/**
 * ==========================================
 * CONFIGURATION SETTINGS (EDIT THESE)
 * ==========================================
 */
const CONFIG = {
  SOURCE_SHEET_NAME: "RawData",        // Name of your main data sheet
  DATA_START_ROW: 2,                   // Row where your data begins (after headers)
  
  // 0-indexed column mappings (e.g., Column A = 0, Column D = 3)
  COL_NAME: 0,                         
  COL_CATEGORY: 3,                     
  COL_PHONE: 4,                        

  // Aggregation Settings
  MIN_COUNT_THRESHOLD: 20,             // Minimum items needed for a dedicated sheet
  AGGREGATE_KEYWORD: "keyword",        // A broad word to group specific low-count items (e.g., "accessories")
  AGGREGATE_SHEET_NAME: "Grouped Items", 
  LOW_COUNT_SHEET_NAME: "Low Volume Items",

  // System Settings
  LOG_SHEET_NAME: "System Log",
  EXPORT_LOG_SHEET_NAME: "Export History",
  DEFAULT_BATCH_SIZE: 200,             // Default contacts per group
  COUNTRY_CODE: "1"                    // Your default country code (e.g., "1" for US, "44" for UK, "91" for India)
};

// Define your categories and the keywords used to find them
const CATEGORY_RULES = [
  { name: "Category One", regex: /\b(item1|item2|item3)\b/ },
  { name: "Category Two", regex: /\b(item4|item5)\b/ }
  // Add as many rules as needed...
];

// Map your final sheet names to the initials/prefixes you want in the CSV exports
const CATEGORY_PREFIXES = {
  "Category One": "C1",
  "Category Two": "C2",
  "Grouped Items": "GRP",
  "Low Volume Items": "LOW"
  // Add mappings for all possible resulting sheet names...
};


/**
 * ==========================================
 * SHEET GENERATION & CATEGORIZATION
 * ==========================================
 */
function generateCategorySheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dataSheet = ss.getSheetByName(CONFIG.SOURCE_SHEET_NAME) || ss.getActiveSheet();
  
  const lastRow = dataSheet.getLastRow();
  if (lastRow < CONFIG.DATA_START_ROW) return; 
  
  // Fetch relevant columns
  const maxCol = Math.max(CONFIG.COL_NAME, CONFIG.COL_CATEGORY, CONFIG.COL_PHONE) + 1;
  const data = dataSheet.getRange(CONFIG.DATA_START_ROW, 1, lastRow - 1, maxCol).getValues();

  let categoryMap = {};

  // STEP 1: Process and count all categories
  data.forEach(row => {
    let rawItem = row[CONFIG.COL_CATEGORY]; 
    if (!rawItem || rawItem === "-") return;
    
    let category = smartNormalize(rawItem);
    if (!category) return;
    
    categoryMap[category] = (categoryMap[category] || 0) + 1;
  });

  // STEP 2: Apply threshold and aggregation logic
  let finalCategoryMap = {};
  Object.entries(categoryMap).forEach(([cat, count]) => {
    if (count >= CONFIG.MIN_COUNT_THRESHOLD) {
      finalCategoryMap[cat] = cat;
    } else {
      let isAggregatedGroup = cat.toLowerCase().includes(CONFIG.AGGREGATE_KEYWORD);
      if (isAggregatedGroup) {
        finalCategoryMap[cat] = CONFIG.AGGREGATE_SHEET_NAME;
      } else {
        finalCategoryMap[cat] = CONFIG.LOW_COUNT_SHEET_NAME; 
      }
    }
  });

  // STEP 3: Route rows to final buckets
  let sheetsData = {};
  data.forEach(row => {
    let customerName = row[CONFIG.COL_NAME]; 
    let itemName = row[CONFIG.COL_CATEGORY];  
    let phoneNumber = row[CONFIG.COL_PHONE];  

    if (!itemName || itemName === "-") return;
    let rawCategory = smartNormalize(itemName);
    if (!rawCategory) return;

    let finalCategory = finalCategoryMap[rawCategory];
    
    // Clean sheet name for Google Sheets safety
    let safeSheetName = finalCategory.replace(/[\/\?\*\[\]\:\\]/g, "-").substring(0, 31).trim();

    if (!sheetsData[safeSheetName]) sheetsData[safeSheetName] = [];
    sheetsData[safeSheetName].push([customerName, itemName, phoneNumber]);
  });

  // STEP 4: Build Sheets and write data
  Object.keys(sheetsData).forEach(sheetName => {
    let targetSheet = ss.getSheetByName(sheetName);
    
    if (!targetSheet) {
      targetSheet = ss.insertSheet(sheetName);
    } else {
      targetSheet.clear();
    }

    let headers = [["Name", "Item", "Phone"]];
    targetSheet.getRange(1, 1, 1, 3).setValues(headers).setFontWeight("bold");

    let rows = sheetsData[sheetName];
    targetSheet.getRange(2, 1, rows.length, 3).setValues(rows);
    targetSheet.autoResizeColumns(1, 3);
  });
}

function smartNormalize(text) {
  if (!text) return "";
  let t = String(text).toLowerCase();

  // Pre-processing cleanup
  t = t.replace(/\n/g, " ");
  t = t.replace(/\b\d+(\.\d+)?\b/g, ""); // remove numbers
  t = t.replace(/[^a-z\s]/g, " "); // remove special characters
  t = t.replace(/\s+/g, " ").trim();
  if (!t) return "";

  // Check against config rules
  for (let i = 0; i < CATEGORY_RULES.length; i++) {
    if (CATEGORY_RULES[i].regex.test(t)) {
      return CATEGORY_RULES[i].name;
    }
  }

  // Fallback if no match
  return "Uncategorized: " + t.replace(/\b\w/g, l => l.toUpperCase()); 
} 

function listAllSheetNames() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets();
  const sheetNames = sheets.map(sheet => [sheet.getName()]);
  
  let logSheet = ss.getSheetByName(CONFIG.LOG_SHEET_NAME) || ss.insertSheet(CONFIG.LOG_SHEET_NAME);
  
  logSheet.getRange(1, 4).setValue("Directory of All Sheets").setFontWeight("bold");
  const maxRows = logSheet.getMaxRows();
  if (maxRows > 1) {
    logSheet.getRange(2, 4, maxRows - 1, 1).clearContent();
  }
  
  logSheet.getRange(2, 4, sheetNames.length, 1).setValues(sheetNames);
  logSheet.autoResizeColumn(4);
}

